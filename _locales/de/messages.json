  "wTitle": { "message": "Cursor Duck ist da 🦆" },
  "wH1": { "message": "Deine Ente ist eingezogen 🦆" },
  "wLead": { "message": "Sie schwimmt ab jetzt auf jeder Website hinter deinem Mauszeiger her. Probier sie gleich hier aus." },
  "wFeatTitle": { "message": "Was sie kann" },
  "wFeat1": { "message": "<b>Hinterherschwimmen:</b> Je weiter weg dein Cursor, desto schneller paddelt sie — mit Kielwasser und Bugwelle." },
  "wFeat2": { "message": "<b>Streicheln:</b> Hol sie ein und wackel mit dem Cursor über ihr — Herzchen inklusive." },
  "wFeat3": { "message": "<b>Picken:</b> Halt die Maus still. Wenn sie aufgeholt hat, pickt sie deinen Cursor an." },
  "wFeat4": { "message": "<b>Füttern:</b> Doppelklick irgendwo auf die Seite wirft Brotkrumen — sie schwimmt hin und pickt sie einzeln auf." },
  "wFeat5": { "message": "<b>Fisch-Jagd:</b> Ab und zu zieht ein Fischschatten vorbei. Sie jagt ihn und schnappt zu — klappt nicht immer." },
  "wFeat6": { "message": "<b>Schwindel:</b> Kreis den Cursor ein paarmal schnell um sie herum — ihr wird schwummrig." },
  "wFeat7": { "message": "<b>Tänzchen:</b> Wackel den Cursor neben ihr schnell hin und her — sie tanzt mit." },
  "wFeat8": { "message": "<b>Kuckuck:</b> Leg den Cursor ruhig auf ihr ab — sie taucht ab und ploppt daneben wieder auf." },
  "wFeat9": { "message": "<b>Erschrecken:</b> Wisch ganz schnell durch sie durch — Federn fliegen." },
  "wFeat10": { "message": "<b>Nickerchen:</b> Nach 15 Sekunden Ruhe schläft sie ein. Zzz." },
  "wFeat11": { "message": "<b>Nebenbei:</b> Gründeln, tauchen, Gefieder putzen, baden, Pirouetten, quaken." },
  "wCtrlTitle": { "message": "Steuerung" },
