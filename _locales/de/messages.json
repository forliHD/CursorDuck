  "uF1b": { "message": "Landgang:" },
  "uF1t": { "message": "Ab und zu klettert sie aus dem Wasser, watschelt einmal stolz im Kreis und springt genau dort wieder hinein." },
  "uF2b": { "message": "Nicht überfüttern:" },
  "uF2t": { "message": "Zu viele Brotkrumen am Stück? Erst hickst sie, dann macht es PLOPP — keine Sorge, sie taucht sofort wieder auf." },
