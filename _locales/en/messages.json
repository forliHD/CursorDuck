  "wTitle": { "message": "Cursor Duck has arrived 🦆" },
  "wH1": { "message": "Your duck has moved in 🦆" },
  "wLead": { "message": "From now on she swims after your mouse pointer on every website. Try her out right here." },
  "wFeatTitle": { "message": "What she can do" },
  "wFeat1": { "message": "<b>Following:</b> The farther away your cursor, the faster she paddles — wake and bow wave included." },
  "wFeat2": { "message": "<b>Petting:</b> Let her catch up, then wiggle the cursor over her — hearts included." },
  "wFeat3": { "message": "<b>Pecking:</b> Hold the mouse still. Once she has caught up, she pecks your cursor." },
  "wFeat4": { "message": "<b>Feeding:</b> Double-click anywhere on the page to toss bread crumbs — she swims over and picks them up one by one." },
  "wFeat5": { "message": "<b>Fish hunt:</b> Every now and then a fish shadow passes by. She chases it and snaps — doesn't always work out." },
  "wFeat6": { "message": "<b>Dizziness:</b> Circle the cursor around her a few times — she gets woozy." },
  "wFeat7": { "message": "<b>Dancing:</b> Wiggle the cursor quickly next to her — she dances along." },
  "wFeat8": { "message": "<b>Peekaboo:</b> Rest the cursor calmly on her — she dives and pops up right next to it." },
  "wFeat9": { "message": "<b>Startling:</b> Swipe through her really fast — feathers fly." },
  "wFeat10": { "message": "<b>Napping:</b> After 15 seconds of quiet she falls asleep. Zzz." },
  "wFeat11": { "message": "<b>On the side:</b> Dabbling, diving, preening, bathing, pirouettes, quacking." },
  "wCtrlTitle": { "message": "Controls" },
  "wCtrl1": { "message": "Click the duck icon in the toolbar: pick a model, size, speed, ducklings, sound." },
  "wCtrl2": { "message": "<kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>D</kbd> — duck on/off" },
  "wCtrl3": { "message": "<kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>N</kbd> — next duck model" },
  "wCtrl4": { "message": "In the way on some site? Use “Pause on this site” in the popup." },
  "wModelsTitle": { "message": "All models" },
  "wTip": { "message": "She floats above the page but never intercepts clicks — links, text and buttons keep working as usual." }
